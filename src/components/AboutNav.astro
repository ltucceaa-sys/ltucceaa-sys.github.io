---
import { url } from '../utils/url';

interface Props {
  current: string;
}

const { current } = Astro.props;

const links = [
  { label: '系友會簡介', href: '/about/' },
  { label: '成立宗旨', href: '/about/mission/' },
  { label: '歷史沿革', href: '/about/history/' },
  { label: '組織架構', href: '/about/organization/' },
  { label: '與幼保系的關係', href: '/about/department/' },
  { label: '現任幹部', href: '/about/officers/' },
  { label: '歷屆會長', href: '/about/presidents/' },
  { label: '歷屆幹部', href: '/about/past-officers/' },
  { label: '會長的話', href: '/about/president-message/' },
];
---

<nav class="about-nav" aria-label="關於系友會">
  <div class="container">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={url(l.href)} aria-current={l.href === current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .about-nav {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 12px 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 6px 16px;
    border-radius: 999px;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  a:hover {
    background: var(--color-primary-soft);
  }

  a[aria-current='page'] {
    background: var(--color-primary);
    color: #fff;
  }

  /* 手機：改成整齊的兩欄格狀，按鈕等寬、文字置中不換行 */
  @media (max-width: 640px) {
    ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      padding: 14px 0;
    }

    a {
      padding: 10px 8px;
      border: 1px solid var(--color-border);
      font-size: 0.95rem;
      line-height: 1.4;
      text-align: center;
      white-space: nowrap;
    }

    a[aria-current='page'] {
      border-color: var(--color-primary);
    }
  }
</style>
