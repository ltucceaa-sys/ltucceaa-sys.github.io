---
import { url } from '../utils/url';

interface Props {
  current: string;
}

const { current } = Astro.props;

const links = [
  { label: '認識系友會', href: '/about/' },
  { label: '現任幹部', href: '/about/officers/' },
  { label: '歷屆會長', href: '/about/presidents/' },
  { label: '歷屆幹部', href: '/about/past-officers/' },
];
---

<nav class="about-nav" aria-label="關於系友會">
  <div class="container">
    <ul>
      {
        links.map((l) => (
          <li>
            <a href={url(l.href)} aria-current={l.href === current ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<style>
  .about-nav {
    background: var(--color-surface);
    border-bottom: 1px solid var(--color-border);
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 12px 0;
    list-style: none;
  }

  a {
    display: block;
    padding: 6px 16px;
    border-radius: 999px;
    color: var(--color-text);
    text-decoration: none;
    font-weight: 500;
  }

  a:hover {
    background: var(--color-primary-soft);
  }

  a[aria-current='page'] {
    background: var(--color-primary);
    color: #fff;
  }
</style>
