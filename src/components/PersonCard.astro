---
import { Image } from 'astro:assets';
import { findImage } from '../utils/images';
import { initials } from '../utils/officers';

interface Props {
  name: string;
  title?: string;
  subtitle?: string;
  photo?: string;
  description?: string;
}

const { name, title, subtitle, photo, description } = Astro.props;
const image = findImage(photo);
---

<article class="person card">
  <div class="person__photo">
    {
      image ? (
        <Image src={image} alt={`${name}的照片`} width={240} height={240} loading="lazy" />
      ) : (
        <span class="person__initials" aria-hidden="true">{initials(name)}</span>
      )
    }
  </div>
  <h3 class="person__name">{name}</h3>
  {title && <p class="person__title">{title}</p>}
  {subtitle && <p class="person__subtitle">{subtitle}</p>}
  {description && <p class="person__desc">{description}</p>}
</article>

<style>
  .person {
    text-align: center;
  }

  .person__photo {
    width: 120px;
    height: 120px;
    margin: 0 auto 16px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--color-primary-soft);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .person__photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .person__initials {
    font-size: 2.4rem;
    font-weight: 700;
    color: var(--color-primary);
  }

  .person__name {
    margin: 0 0 4px;
    font-size: 1.15rem;
  }

  .person__title {
    margin: 0 0 8px;
    color: var(--color-primary);
    font-weight: 700;
  }

  .person__subtitle {
    margin: 0 0 8px;
    color: var(--color-text-soft);
    font-size: 0.9rem;
  }

  .person__desc {
    margin: 0;
    color: var(--color-text-soft);
    font-size: 0.95rem;
    text-align: left;
  }
</style>
