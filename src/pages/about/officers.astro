---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutNav from '../../components/AboutNav.astro';
import PersonCard from '../../components/PersonCard.astro';
import { currentOfficers, officersByTerm } from '../../utils/officers';

const all = currentOfficers();
const termInfo = officersByTerm(all)[0];

// 同一個人兼任多個職稱時，合併成一張卡片，職稱以「、」連接。
const current = [];
for (const o of all) {
  const same = current.find((c) => c.name === o.name);
  if (same) {
    same.title = `${same.title}、${o.title}`;
    same.description ||= o.description;
    same.photo ||= o.photo;
  } else {
    current.push({ ...o });
  }
}
const heading = termInfo
  ? `第 ${termInfo.term} 屆${termInfo.year ? `（${termInfo.year} 年）` : ''}`
  : '';
---

<BaseLayout title="現任幹部" description="嶺東幼保系友會現任幹部名單。">
  <AboutNav current="/about/officers/" />

  <section class="section">
    <div class="container">
      <h1 class="section__title">現任幹部</h1>
      {heading && <p class="term">{heading}</p>}
      {
        current.length > 0 ? (
          <div class="grid">
            {current.map((o) => (
              <PersonCard
                name={o.name}
                title={o.title}
                photo={o.photo}
                description={o.description}
              />
            ))}
          </div>
        ) : (
          <div class="empty">現任幹部名單即將更新。</div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .term {
    margin: -0.8em 0 1.6em;
    text-align: center;
    color: var(--color-text-soft);
  }
</style>
