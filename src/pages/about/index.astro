---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutNav from '../../components/AboutNav.astro';
import about from '../../data/about.json';
import { url } from '../../utils/url';

const sections = [
  { id: 'intro', data: about.association_intro },
  { id: 'mission', data: about.mission },
  { id: 'history', data: about.history },
  { id: 'organization', data: about.organization },
  { id: 'relationship', data: about.relationship_with_department },
  { id: 'message', data: about.president_message },
];

const messageByline = [about.president_message.president_name, about.president_message.term]
  .filter(Boolean)
  .join('　');
---

<BaseLayout
  title="關於系友會"
  description="認識嶺東幼保系友會：成立宗旨、歷史沿革、組織架構與會長的話。"
>
  <AboutNav current="/about/" />

  <section class="section page-head">
    <div class="container">
      <h1>關於系友會</h1>
      <ul class="toc">
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.data.title}</a></li>)}
      </ul>
    </div>
  </section>

  {/* 系友會簡介 */}
  <section class="section" id="intro">
    <div class="container prose">
      <h2 class="section__title">{about.association_intro.title}</h2>
      {
        about.association_intro.paragraphs.length > 0 ? (
          about.association_intro.paragraphs.map((p) => <p>{p}</p>)
        ) : (
          <div class="empty">內容即將更新。</div>
        )
      }
    </div>
  </section>

  {/* 成立宗旨 */}
  <section class="section section--soft" id="mission">
    <div class="container prose">
      <h2 class="section__title">{about.mission.title}</h2>
      {
        about.mission.paragraphs.length > 0 ? (
          about.mission.paragraphs.map((p) => <p>{p}</p>)
        ) : (
          <div class="empty">內容即將更新。</div>
        )
      }
    </div>
  </section>

  {/* 歷史沿革 */}
  <section class="section" id="history">
    <div class="container prose">
      <h2 class="section__title">{about.history.title}</h2>
      {
        about.history.items.length > 0 ? (
          <ol class="timeline">
            {about.history.items.map((item) => (
              <li>
                <span class="timeline__year">{item.year}</span>
                <span>{item.text}</span>
              </li>
            ))}
          </ol>
        ) : (
          <div class="empty">內容即將更新。</div>
        )
      }
    </div>
  </section>

  {/* 組織架構 */}
  <section class="section section--soft" id="organization">
    <div class="container prose">
      <h2 class="section__title">{about.organization.title}</h2>
      {about.organization.paragraphs.map((p) => <p>{p}</p>)}
      {
        about.organization.roles.length > 0 && (
          <ul class="roles" aria-label="幹部職稱">
            {about.organization.roles.map((r) => <li>{r}</li>)}
          </ul>
        )
      }
      <p class="more">
        <a class="btn" href={url('/about/officers/')}>看現任幹部</a>
        <a class="btn btn--outline" href={url('/about/past-officers/')}>看歷屆幹部</a>
      </p>
    </div>
  </section>

  {/* 系友會與幼保系的關係 */}
  <section class="section" id="relationship">
    <div class="container prose">
      <h2 class="section__title">{about.relationship_with_department.title}</h2>
      {
        about.relationship_with_department.paragraphs.length > 0 ? (
          about.relationship_with_department.paragraphs.map((p) => <p>{p}</p>)
        ) : (
          <div class="empty">內容即將更新。</div>
        )
      }
    </div>
  </section>

  {/* 會長的話 */}
  <section class="section section--soft" id="message">
    <div class="container prose">
      <h2 class="section__title">{about.president_message.title}</h2>
      {
        about.president_message.paragraphs.length > 0 ? (
          <>
            {about.president_message.paragraphs.map((p) => <p>{p}</p>)}
            {messageByline && <p class="byline">— {messageByline}</p>}
          </>
        ) : (
          <div class="empty">內容即將更新。</div>
        )
      }
      <p class="more">
        <a class="btn btn--outline" href={url('/about/presidents/')}>認識歷屆會長</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-head {
    padding-bottom: 24px;
    text-align: center;
  }

  .toc {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .toc a {
    color: var(--color-primary);
  }

  .prose {
    max-width: 760px;
  }

  .prose p {
    line-height: 1.9;
  }

  .timeline {
    margin: 0;
    padding: 0;
    list-style: none;
    border-left: 3px solid var(--color-primary-soft);
  }

  .timeline li {
    display: flex;
    gap: 16px;
    padding: 0 0 20px 20px;
  }

  .timeline__year {
    flex: 0 0 4em;
    font-weight: 700;
    color: var(--color-primary);
  }

  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .roles li {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .byline {
    text-align: right;
    color: var(--color-text-soft);
  }

  .more {
    margin-top: 28px;
    text-align: center;
  }

  .more .btn {
    margin: 4px;
  }

  section[id] {
    scroll-margin-top: 80px;
  }
</style>
