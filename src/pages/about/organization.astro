---
import AboutTextPage from '../../components/AboutTextPage.astro';
import about from '../../data/about.json';
import OrgChart from '../../components/OrgChart.astro';
import { url } from '../../utils/url';
const d = about.organization;
---

<AboutTextPage
  current="/about/organization/"
  title={d.title}
  paragraphs={d.paragraphs}
  description="嶺東幼保系友會的組織架構與幹部職稱。"
>
  <OrgChart levels={d.chart.levels} branches={d.chart.branches} />
  <p class="more">
    <a class="btn" href={url('/about/officers/')}>看現任幹部</a>
    <a class="btn btn--outline" href={url('/about/past-officers/')}>看歷屆幹部</a>
  </p>
</AboutTextPage>

<style>
  .more {
    margin-top: 28px;
    text-align: center;
  }

  .more .btn {
    margin: 4px;
  }
</style>
