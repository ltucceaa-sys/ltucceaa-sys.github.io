---
import AboutTextPage from '../../components/AboutTextPage.astro';
import about from '../../data/about.json';
import { url } from '../../utils/url';
const d = about.organization;
---

<AboutTextPage
  current="/about/organization/"
  title={d.title}
  paragraphs={d.paragraphs}
  description="嶺東幼保系友會的組織架構與幹部職稱。"
>
  {
    d.roles.length > 0 && (
      <ul class="roles" aria-label="幹部職稱">
        {d.roles.map((r) => <li>{r}</li>)}
      </ul>
    )
  }
  <p class="more">
    <a class="btn" href={url('/about/officers/')}>看現任幹部</a>
    <a class="btn btn--outline" href={url('/about/past-officers/')}>看歷屆幹部</a>
  </p>
</AboutTextPage>

<style>
  .roles {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0 0 24px;
    padding: 0;
    list-style: none;
  }

  .roles li {
    padding: 6px 16px;
    border-radius: 999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .more {
    margin-top: 28px;
    text-align: center;
  }

  .more .btn {
    margin: 4px;
  }
</style>
