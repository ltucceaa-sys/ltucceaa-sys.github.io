---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { findImage } from '../../utils/images';
import { formatDate, isoDate, EVENT_STATUS_LABEL } from '../../utils/format';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const events = await getCollection('events', (e) => !e.data.draft);
  return events.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const e = entry.data;
const cover = findImage(e.cover);
const time = [e.startTime, e.endTime].filter(Boolean).join(' – ');
const isOpen = e.status === 'registration' || e.status === 'upcoming';

const info = [
  { label: '日期', value: formatDate(e.date) },
  { label: '時間', value: time },
  { label: '地點', value: e.location },
  { label: '主辦單位', value: e.organizer },
  { label: '協辦單位', value: e.coOrganizer },
].filter((i) => i.value);

const pageImage = cover ? cover.src : undefined;
---

<BaseLayout title={e.title} description={e.summary || undefined} image={pageImage} type="article">
  <article class="section">
    <div class="container">
      <p class="back"><a href={url('/events/')}>← 回活動專區</a></p>

      <header class="head">
        <span class={`status ${isOpen ? 'status--open' : ''}`}>{EVENT_STATUS_LABEL[e.status]}</span>
        <h1>{e.title}</h1>
      </header>

      <div class="layout">
        {
          cover && (
            <div class="poster">
              <a href={cover.src} target="_blank" rel="noopener">
                <Image src={cover} alt={`${e.title} 海報`} width={640} />
              </a>
            </div>
          )
        }
        <div class="info card">
          <dl>
            {
              info.map((i) => (
                <>
                  <dt>{i.label}</dt>
                  <dd>
                    {i.label === '日期' ? (
                      <time datetime={isoDate(e.date)}>{i.value}</time>
                    ) : (
                      i.value
                    )}
                  </dd>
                </>
              ))
            }
          </dl>
          {
            e.registrationUrl && isOpen && (
              <p class="cta">
                <a class="btn" href={e.registrationUrl} target="_blank" rel="noopener">
                  我要報名
                </a>
              </p>
            )
          }
          {
            e.links.length > 0 && (
              <ul class="links">
                {e.links.map((l) => (
                  <li>
                    <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
                  </li>
                ))}
              </ul>
            )
          }
        </div>
      </div>

      <div class="markdown body">
        <Content />
      </div>

      <PhotoGallery photos={e.gallery} />

      <p class="back back--bottom"><a class="btn btn--outline" href={url('/events/')}>回活動專區</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .back a {
    color: var(--color-primary);
  }

  .back--bottom {
    margin-top: 40px;
    text-align: center;
  }

  .head {
    margin-bottom: 28px;
  }

  .status {
    display: inline-block;
    margin-bottom: 10px;
    padding: 3px 14px;
    border-radius: 999px;
    background: #8a7f78;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .status--open {
    background: var(--color-accent);
  }

  .layout {
    display: grid;
    gap: 28px;
    grid-template-columns: 1fr;
    align-items: start;
    margin-bottom: 8px;
  }

  @media (min-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 360px) 1fr;
    }
  }

  .poster :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }

  dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: 14px 20px;
    margin: 0;
  }

  dt {
    color: var(--color-text-soft);
    font-weight: 700;
  }

  dd {
    margin: 0;
  }

  .cta {
    margin: 24px 0 0;
  }

  .links {
    margin: 20px 0 0;
    padding-left: 1.2em;
  }

  .body {
    max-width: 820px;
  }
</style>
