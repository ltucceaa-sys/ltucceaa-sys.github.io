---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import { findImage } from '../../utils/images';
import { formatDate, isoDate } from '../../utils/format';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const news = await getCollection('news', (n) => !n.data.draft);
  return news.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const n = entry.data;
const cover = findImage(n.cover);
---

<BaseLayout title={n.title} description={n.summary || undefined} image={cover?.src} type="article">
  <article class="section">
    <div class="container article">
      <p class="back"><a href={url('/news/')}>← 回最新消息</a></p>

      <header class="head">
        <p class="meta">
          <span class="cat">{n.category}</span>
          <time datetime={isoDate(n.date)}>{formatDate(n.date, false)}</time>
          <span>作者：{n.author}</span>
        </p>
        <h1>{n.title}</h1>
      </header>

      {cover && <Image class="cover" src={cover} alt="" width={960} />}

      <div class="markdown">
        <Content />
      </div>

      {
        n.links.length > 0 && (
          <section class="related">
            <h2>相關連結</h2>
            <ul>
              {n.links.map((l) => (
                <li>
                  <a href={l.url} target="_blank" rel="noopener">{l.label}</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <PhotoGallery photos={n.gallery} title="相關照片" />

      <p class="back back--bottom"><a class="btn btn--outline" href={url('/news/')}>回最新消息</a></p>
    </div>
  </article>
</BaseLayout>

<style>
  .article {
    max-width: 820px;
  }

  .back a {
    color: var(--color-primary);
  }

  .back--bottom {
    margin-top: 40px;
    text-align: center;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
    margin: 0 0 8px;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }

  .cat {
    padding: 2px 12px;
    border-radius: 999px;
    background: var(--color-primary);
    color: #fff;
    font-weight: 700;
    font-size: 0.85rem;
  }

  .article :global(.cover) {
    width: 100%;
    height: auto;
    margin: 0 0 28px;
    border-radius: var(--radius);
  }

  .related {
    margin-top: 2em;
  }
</style>
