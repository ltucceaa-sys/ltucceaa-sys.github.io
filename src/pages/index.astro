---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/site-settings.json';
import { url } from '../utils/url';
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <img class="hero__logo" src={url('/logo-mark.png')} alt="" width="112" height="112" />
      <p class="hero__eyebrow">歡迎回家</p>
      <h1>{settings.name}</h1>
      <p class="hero__en">{settings.englishName}</p>
      <p class="hero__lead">
        串起每一位幼保人的連結，分享消息、活動與成長，一起陪孩子也陪彼此。
      </p>
      <a class="btn" href={`mailto:${settings.email}`}>聯絡系友會</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: flex;
    align-items: center;
    min-height: 68vh;
    padding: 64px 0;
    text-align: center;
    background:
      radial-gradient(circle at 15% 20%, var(--color-accent-soft), transparent 45%),
      radial-gradient(circle at 85% 80%, var(--color-primary-soft), transparent 45%),
      var(--color-bg);
  }

  .hero__logo {
    display: block;
    width: 112px;
    height: 112px;
    margin: 0 auto 12px;
  }

  .hero__eyebrow {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .hero__en {
    max-width: 640px;
    margin: 0 auto 20px;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }

  .hero__lead {
    max-width: 560px;
    margin: 0 auto 28px;
    font-size: 1.1rem;
  }


</style>
