---
import BaseLayout from '../layouts/BaseLayout.astro';
import settings from '../data/site-settings.json';
import { url } from '../utils/url';
import { getCollection } from 'astro:content';
import PostCard from '../components/PostCard.astro';
import { formatDate, isoDate, EVENT_STATUS_LABEL } from '../utils/format';

const latestNews = (await getCollection('news', (n) => !n.data.draft))
  .sort((a, b) => +b.data.date - +a.data.date)
  .slice(0, 3);

const upcomingEvents = (
  await getCollection(
    'events',
    (e) => !e.data.draft && (e.data.status === 'registration' || e.data.status === 'upcoming'),
  )
)
  .sort((a, b) => +a.data.date - +b.data.date)
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero">
    <div class="container hero__inner">
      <img class="hero__logo" src={url('/logo-mark.png')} alt="" width="112" height="112" />
      <p class="hero__eyebrow">歡迎回家</p>
      <h1>{settings.name}</h1>
      <p class="hero__en">{settings.englishName}</p>
      <p class="hero__lead">
        串起每一位幼保人的連結，分享消息、活動與成長，一起陪孩子也陪彼此。
      </p>
      <a class="btn" href={`mailto:${settings.email}`}>聯絡系友會</a>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">最新消息</h2>
      {
        latestNews.length > 0 ? (
          <div class="grid">
            {latestNews.map((n) => (
              <PostCard
                href={url(`/news/${n.id}/`)}
                title={n.data.title}
                cover={n.data.cover}
                badge={n.data.category}
                dateText={formatDate(n.data.date, false)}
                dateIso={isoDate(n.data.date)}
                summary={n.data.summary}
              />
            ))}
          </div>
        ) : (
          <div class="empty">最新消息即將上線，敬請期待。</div>
        )
      }
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <h2 class="section__title">近期活動</h2>
      {
        upcomingEvents.length > 0 ? (
          <div class="grid">
            {upcomingEvents.map((e) => (
              <PostCard
                href={url(`/events/${e.id}/`)}
                title={e.data.title}
                cover={e.data.cover}
                badge={EVENT_STATUS_LABEL[e.data.status]}
                badgeTone={e.data.status === 'registration' ? 'accent' : 'primary'}
                dateText={formatDate(e.data.date)}
                dateIso={isoDate(e.data.date)}
                meta={e.data.location}
                summary={e.data.summary}
              />
            ))}
          </div>
        ) : (
          <div class="empty">目前沒有近期活動。</div>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2 class="section__title">系友風采</h2>
      <div class="empty">系友故事與職涯分享，敬請期待。</div>
    </div>
  </section>

  <section class="section section--soft cta">
    <div class="container">
      <h2>想和系友會聯絡嗎？</h2>
      <p>有任何問題或建議，歡迎寄信給我們。</p>
      <a class="btn" href={`mailto:${settings.email}`}>聯絡系友會</a>
      <a class="btn btn--outline" href={url('/about/')}>認識系友會</a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: 80px 0 72px;
    text-align: center;
    background:
      radial-gradient(circle at 15% 20%, var(--color-accent-soft), transparent 45%),
      radial-gradient(circle at 85% 80%, var(--color-primary-soft), transparent 45%),
      var(--color-bg);
  }

  .hero__logo {
    display: block;
    width: 112px;
    height: 112px;
    margin: 0 auto 12px;
  }

  .hero__eyebrow {
    margin: 0 0 8px;
    color: var(--color-accent);
    font-weight: 700;
    letter-spacing: 0.2em;
  }

  .hero__en {
    max-width: 640px;
    margin: 0 auto 20px;
    color: var(--color-text-soft);
    font-size: 0.95rem;
  }

  .hero__lead {
    max-width: 560px;
    margin: 0 auto 28px;
    font-size: 1.1rem;
  }

  .cta {
    text-align: center;
  }

  .cta .btn {
    margin: 4px;
  }
</style>
